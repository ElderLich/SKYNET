<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <dllmap dll="sqlite3" target="libsqlite3.so.0" os="linux" />
    <appSettings>
        <add key="UsePreErrataEffects" value="false"/>
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
</configuration>
