<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <!-- Mono reads dllmap itself; Windows ConfigurationManager must ignore it. -->
        <section name="dllmap" type="System.Configuration.IgnoreSection, System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
    </configSections>
    <dllmap dll="sqlite3" target="libsqlite3.so.0" os="linux" />
    <appSettings>
        <add key="UsePreErrataEffects" value="false"/>
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
</configuration>
